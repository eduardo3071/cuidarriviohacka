# MODELO: copie para .env (que o git ignora) e preencha la. NUNCA coloque segredos neste arquivo.
# ---- Supabase (projeto Rivio-Hackathon) ----
SUPABASE_PROJECT_REF=itbtpzdxatpkndgsxdlx
SUPABASE_URL=https://itbtpzdxatpkndgsxdlx.supabase.co
# Chave secreta (sb_secret_...): Dashboard > Settings > API Keys. SOMENTE no backend; nunca no front nem no git.
SUPABASE_SECRET_KEY=
# Conexao Postgres pelo pooler (transaction mode, porta 6543) para o SQLAlchemy (driver psycopg 3)
DATABASE_URL=postgresql+psycopg://postgres.itbtpzdxatpkndgsxdlx:<SENHA>@<HOST_POOLER>:6543/postgres
STORAGE_BUCKET=documents
MAX_UPLOAD_MB=15

# ---- API ----
# Origens permitidas no CORS, separadas por virgula
CORS_ORIGINS=http://localhost:5173

# ---- Extracao ----
# OCR local (OpenCV + RapidOCR): ~400 MB de RAM e 10+ s por pagina. NAO ligue no Render gratuito (512 MB).
OCR_ENABLED=false

# ---- IA hospedada (LLMClient) ----
LLM_PROVIDER=anthropic
# Vazio = padrao do adaptador (claude-opus-5-5). Modelos mais baratos: decisao do time.
LLM_MODEL=
# Chave da API Anthropic. SOMENTE no backend/.env (e nas variaveis do Render). Nunca no git nem no front.
ANTHROPIC_API_KEY=

# ---- Front (Vite) ----
VITE_SUPABASE_URL=https://itbtpzdxatpkndgsxdlx.supabase.co
# Chave publicavel (anon/publishable). Pode ir no front.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_URL=http://localhost:8000
# true enquanto os dados forem de demonstracao: mantem o aviso 'dados sinteticos' na tela
VITE_SYNTHETIC_DATA=true
